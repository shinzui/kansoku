{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "ep53-object-reader",
    "namespace": "nagare-system",
    "labels": {
      "kansoku.dev/fixture": "ep53"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "containers": [
      {
        "name": "reader",
        "image": "docker.io/library/kansoku-ep53-minio:client",
        "imagePullPolicy": "Never",
        "command": [
          "/bin/sh",
          "-c",
          "sleep 36000"
        ],
        "env": [
          {
            "name": "AWS_ACCESS_KEY_ID",
            "valueFrom": {
              "secretKeyRef": {
                "name": "nagare-minio-credentials",
                "key": "AWS_ACCESS_KEY_ID"
              }
            }
          },
          {
            "name": "AWS_SECRET_ACCESS_KEY",
            "valueFrom": {
              "secretKeyRef": {
                "name": "nagare-minio-credentials",
                "key": "AWS_SECRET_ACCESS_KEY"
              }
            }
          }
        ]
      }
    ]
  }
}
