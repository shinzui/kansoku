cabal-version: 3.0
name:          kansoku-api
version:       0.1.0.0
synopsis:      Servant API and wire DTO types for Kansoku.
description:
  Shared Servant route types, analytics event types, metric DTOs, validation,
  and the Kansoku prelude used by Kansoku packages and clients.

license:       BSD-3-Clause
author:        Nadeem Bitar
maintainer:    nadeem@gmail.com
category:      Web
build-type:    Simple

common common
  ghc-options:        -Wall -Wcompat -Wredundant-constraints
  default-language:   GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

library
  import:          common
  hs-source-dirs:  src
  exposed-modules:
    Kansoku.Api
    Kansoku.Event
    Kansoku.Event.Registry
    Kansoku.Event.Types
    Kansoku.Event.Validation
    Kansoku.Ingest.Api
    Kansoku.Metrics.Api
    Kansoku.Prelude

  build-depends:
    , aeson
    , base           >=4.21 && <5
    , containers
    , generic-lens   >=2.2  && <2.4
    , http-api-data
    , lens           ^>=5.3
    , servant
    , text
    , time
    , uuid
