cabal-version: 3.0
name:          kansoku
version:       0.1.0.0
synopsis:      Self-hostable product and web analytics service.
description:
  Kansoku (観測, "observation") ingests analytics events, stores them in
  ClickHouse, and serves typed metric queries. This package is the buildable
  foundation: the shared prelude, the effectful runtime, configuration,
  logging, and a health endpoint.

license:       BSD-3-Clause
author:        Nadeem Bitar
maintainer:    nadeem@gmail.com
build-type:    Simple

common common
  ghc-options:        -Wall -Wcompat -Wredundant-constraints
  default-language:   GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

library kansoku-api
  import:          common
  hs-source-dirs:  api
  exposed-modules:
    Kansoku.Event
    Kansoku.Event.Registry
    Kansoku.Event.Types
    Kansoku.Event.Validation
    Kansoku.Prelude

  build-depends:
    , aeson
    , base          >=4.21 && <5
    , containers
    , generic-lens  ^>=2.2
    , lens          ^>=5.3
    , servant
    , text
    , time
    , uuid

library
  import:          common
  hs-source-dirs:  src
  exposed-modules:
    Kansoku
    Kansoku.Config
    Kansoku.Logging
    Kansoku.Runtime
    Kansoku.Server

  build-depends:
    , aeson
    , base                 >=4.21 && <5
    , bytestring
    , containers
    , effectful
    , effectful-core
    , generic-lens         ^>=2.2
    , http-types
    , kansoku:kansoku-api
    , text
    , time
    , wai
    , warp

executable kansoku-server
  import:         common
  ghc-options:    -threaded
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:
    , base
    , kansoku

test-suite kansoku-test
  import:         common
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  other-modules:
    Kansoku.ConfigSpec
    Kansoku.EventSpec

  build-depends:
    , aeson
    , base
    , bytestring
    , generic-lens
    , hspec
    , kansoku
    , kansoku:kansoku-api
