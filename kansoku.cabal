cabal-version: 3.0
name:          kansoku
version:       0.1.0.0
synopsis:      Self-hostable product and web analytics service.
description:
  Kansoku (観測, "observation") ingests analytics events, stores them in
  ClickHouse, and serves typed metric queries. This package is the buildable
  foundation: the shared prelude, the effectful runtime, configuration,
  logging, and a health endpoint.

license:       BSD-3-Clause
author:        Nadeem Bitar
maintainer:    nadeem@gmail.com
build-type:    Simple

common common
  ghc-options:        -Wall -Wcompat -Wredundant-constraints
  default-language:   GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

library kansoku-api
  import:          common
  hs-source-dirs:  api
  exposed-modules:
    Kansoku.Api.Ingest
    Kansoku.Event
    Kansoku.Event.Registry
    Kansoku.Event.Types
    Kansoku.Event.Validation
    Kansoku.Prelude

  build-depends:
    , aeson
    , base          >=4.21 && <5
    , containers
    , generic-lens  >=2.2  && <2.4
    , lens          ^>=5.3
    , servant
    , text
    , time
    , uuid

library
  import:          common
  hs-source-dirs:  src
  exposed-modules:
    Kansoku
    Kansoku.ClickHouse
    Kansoku.ClickHouse.EventRow
    Kansoku.Config
    Kansoku.Ingest.Handler
    Kansoku.Ingest.Producer
    Kansoku.Ingest.Queue
    Kansoku.Logging
    Kansoku.Postgres
    Kansoku.Runtime
    Kansoku.Server
    Kansoku.Telemetry
    Kansoku.Writer.Batch
    Kansoku.Writer.Run

  build-depends:
    , aeson
    , async
    , base                  >=4.21 && <5
    , bytestring
    , ClickHaskell
    , containers
    , effectful
    , effectful-core
    , generic-lens          >=2.2  && <2.4
    , hasql
    , hasql-pool
    , hs-opentelemetry-api
    , http-types
    , kansoku:kansoku-api
    , pgmq-core
    , pgmq-effectful
    , pgmq-hasql
    , pgmq-migration
    , servant
    , servant-server
    , shibuya-core
    , shibuya-pgmq-adapter
    , text
    , time
    , unordered-containers
    , wai
    , warp

executable kansoku-server
  import:         common
  ghc-options:    -threaded
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:
    , async
    , base
    , generic-lens
    , hasql-pool
    , kansoku
    , kansoku:kansoku-api

test-suite kansoku-test
  import:         common
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  other-modules:
    Kansoku.ClickHouseSpec
    Kansoku.ConfigSpec
    Kansoku.EventSpec
    Kansoku.Ingest.QueueSpec
    Kansoku.Writer.BatchSpec

  build-depends:
    , aeson
    , base
    , bytestring
    , ClickHaskell
    , effectful
    , generic-lens
    , hspec
    , kansoku
    , kansoku:kansoku-api
    , pgmq-core
    , shibuya-core
    , text
    , time
    , unordered-containers
