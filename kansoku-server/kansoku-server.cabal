cabal-version: 3.0
name: kansoku-server
version: 0.1.0.0
synopsis: Kansoku HTTP server executable.
description:
  The servant/warp HTTP server executable for Kansoku analytics.

license: BSD-3-Clause
author: Nadeem Bitar
maintainer: nadeem@gmail.com
category: Web
build-type: Simple
extra-source-files:
  migrations/clickhouse/*.json
  migrations/clickhouse/native-assertions/*.sql
  migrations/clickhouse/original/*.sql
  migrations/clickhouse/original/migrate.sh
  migrations/clickhouse/steps/**/*.sql

common common
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
    -Werror=missing-fields

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

executable kansoku-server
  import: common
  ghc-options: -threaded
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    async,
    base >=4.21 && <5,
    generic-lens,
    hasql-pool,
    kansoku-api,
    kansoku-core,
    text,
    unix,

executable kansoku-migrate
  import: common
  hs-source-dirs: app
  main-is: Migrate.hs
  build-depends:
    aeson,
    base >=4.21 && <5,
    bytestring,
    hasql,
    kansoku-core,
    optparse-applicative,
    pg-migrate,
    pg-migrate-cli,
    text,

executable kansoku-admin
  import: common
  ghc-options: -threaded
  hs-source-dirs: app
  main-is: Admin.hs
  build-depends:
    base >=4.21 && <5,
    kansoku-core,

executable kansoku-ch-migrate
  import: common
  ghc-options: -threaded
  hs-source-dirs:
    app
    src

  main-is: ClickHouseMigrate.hs
  other-modules:
    Kansoku.ClickHouseMigration.Command
    Kansoku.ClickHouseMigration.Config
    Kansoku.ClickHouseMigration.Coordinator
    Kansoku.ClickHouseMigrations

  build-depends:
    aeson,
    base >=4.21 && <5,
    bytestring,
    clickhouse-migrate ==0.1.0.1,
    clickhouse-migrate-cli ==0.1.0.1,
    clickhouse-migrate-embed ==0.1.0.1,
    http-client,
    http-client-tls,
    kansoku-core,
    optparse-applicative,
    text,

flag migration-acceptance-probe
  description: Compile a separate CLI with a test-only appended native migration
  default: False
  manual: True

executable kansoku-ch-migrate-upgrade-proof
  import: common
  ghc-options: -threaded
  hs-source-dirs:
    app
    src

  main-is: ClickHouseMigrateProof.hs
  other-modules:
    Kansoku.ClickHouseMigration.Command
    Kansoku.ClickHouseMigration.Config
    Kansoku.ClickHouseMigration.Coordinator
    Kansoku.ClickHouseMigration.UpgradeProof
    Kansoku.ClickHouseMigrations

  build-depends:
    aeson,
    base >=4.21 && <5,
    bytestring,
    clickhouse-migrate ==0.1.0.1,
    clickhouse-migrate-cli ==0.1.0.1,
    clickhouse-migrate-embed ==0.1.0.1,
    containers,
    http-client,
    http-client-tls,
    kansoku-core,
    optparse-applicative,
    text,

  if !flag(migration-acceptance-probe)
    buildable: False

flag native-migration-tests
  description: Run the owned native migration integration proof explicitly
  default: False
  manual: True

test-suite clickhouse-migrations
  import: common
  type: exitcode-stdio-1.0
  ghc-options: -threaded
  hs-source-dirs:
    test
    src

  main-is: ClickHouseMigrations.hs
  other-modules: Kansoku.ClickHouseMigrations
  build-depends:
    aeson,
    base >=4.21 && <5,
    clickhouse-migrate ==0.1.0.1,
    clickhouse-migrate-embed ==0.1.0.1,
    clickhouse-migrate-test-support ==0.1.0.1,
    text,

  if !flag(native-migration-tests)
    buildable: False
