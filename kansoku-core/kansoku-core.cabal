cabal-version: 3.0
name: kansoku-core
version: 0.1.0.0
synopsis:
  Core Kansoku runtime, storage, ingestion, and metrics logic.

description:
  Kansoku core contains the effectful runtime, configuration, logging,
  persistence adapters, ingestion queueing, metric query implementation, OpenAPI
  generation, and HTTP application assembly shared by the server executable.

license: BSD-3-Clause
author: Nadeem Bitar
maintainer: nadeem@gmail.com
category: Web
build-type: Simple
extra-source-files:
  test/fixtures/geoip/GeoIP2-Country-Test.mmdb
  test/fixtures/geoip/GeoIP2-ISP-Test.mmdb
  test/fixtures/geoip/LICENSE-MIT
  test/fixtures/geoip/README.md
  test/fixtures/user-agents.json

common common
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
    -Werror=missing-fields

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Kansoku
    Kansoku.Auth.Handler
    Kansoku.Auth.Issue
    Kansoku.Auth.Store
    Kansoku.Auth.Token
    Kansoku.Auth.Types
    Kansoku.ClickHouse
    Kansoku.ClickHouse.EventRow
    Kansoku.Config
    Kansoku.Exception
    Kansoku.Health
    Kansoku.Identity.Cache
    Kansoku.Ingest.Acceptance
    Kansoku.Ingest.Channel
    Kansoku.Ingest.Enrichment
    Kansoku.Ingest.GeoIP
    Kansoku.Ingest.Handler
    Kansoku.Ingest.Producer
    Kansoku.Ingest.Quarantine
    Kansoku.Ingest.Queue
    Kansoku.Ingest.QueuedEvent
    Kansoku.Ingest.RateLimit
    Kansoku.Ingest.RequestContext
    Kansoku.Ingest.Service
    Kansoku.Ingest.Timestamp
    Kansoku.Ingest.UserAgent
    Kansoku.Logging
    Kansoku.Metrics.Definition
    Kansoku.Metrics.Handler
    Kansoku.Metrics.Query
    Kansoku.Metrics.Query.Dimension
    Kansoku.Metrics.Query.Filter
    Kansoku.Metrics.Query.Funnel
    Kansoku.Metrics.Query.Property
    Kansoku.Metrics.Query.Session
    Kansoku.Metrics.Query.Validate
    Kansoku.Metrics.Registry
    Kansoku.Metrics.RequestValidation
    Kansoku.Migrations
    Kansoku.Observability
    Kansoku.Postgres
    Kansoku.Readiness
    Kansoku.RequestLog
    Kansoku.Runtime
    Kansoku.Server
    Kansoku.Telemetry
    Kansoku.Writer.Batch
    Kansoku.Writer.Recovery
    Kansoku.Writer.Run

  c-sources: cbits/geoip.c
  pkgconfig-depends: libmaxminddb >=1.14.1 && <2
  build-depends:
    ClickHaskell,
    aeson >=2.2.1,
    async,
    base >=4.21 && <5,
    base64-bytestring,
    bytestring,
    containers,
    crypton,
    effectful,
    effectful-core,
    generic-lens >=2.2 && <2.4,
    hasql,
    hasql-pool,
    hasql-transaction,
    hs-opentelemetry-api,
    hs-opentelemetry-exporter-handle,
    hs-opentelemetry-instrumentation-servant,
    hs-opentelemetry-instrumentation-wai,
    hs-opentelemetry-sdk,
    http-types,
    iproute >=1.7.15 && <1.8,
    kansoku-api,
    network,
    network-uri >=2.6.4.2 && <2.7,
    pg-migrate,
    pgmq-core,
    pgmq-effectful,
    pgmq-hasql,
    pgmq-migration,
    postgresql-libpq >=0.11 && <0.12,
    prometheus-client,
    resource-pool,
    servant,
    servant-health >=0.1.0.0 && <0.2,
    servant-server,
    shibuya-core,
    shibuya-pgmq-adapter,
    stm,
    streamly-core,
    text,
    time,
    unordered-containers,
    uuid,
    wai,
    wai-cors,
    wai-extra,
    warp,

test-suite kansoku-core-test
  import: common
  ghc-options: -threaded
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
    Kansoku.Auth.HandlerSpec
    Kansoku.Auth.TokenSpec
    Kansoku.ClickHouseSpec
    Kansoku.ClickHouseTestSupport
    Kansoku.ConfigSpec
    Kansoku.ContractSpec
    Kansoku.CorsSpec
    Kansoku.EventSpec
    Kansoku.HealthSpec
    Kansoku.HttpIntegrationSpec
    Kansoku.HttpTelemetrySpec
    Kansoku.Identity.CacheSpec
    Kansoku.Ingest.AcceptanceSpec
    Kansoku.Ingest.AdmissionSpec
    Kansoku.Ingest.EnrichmentIntegrationSpec
    Kansoku.Ingest.EnrichmentSpec
    Kansoku.Ingest.GeoIPSpec
    Kansoku.Ingest.HandlerSpec
    Kansoku.Ingest.QueueSpec
    Kansoku.Ingest.RateLimitSpec
    Kansoku.Ingest.ServiceSpec
    Kansoku.Ingest.TimestampSpec
    Kansoku.LimitsSpec
    Kansoku.Metrics.AcquisitionIntegrationSpec
    Kansoku.Metrics.ActivityIntegrationSpec
    Kansoku.Metrics.FilterIntegrationSpec
    Kansoku.Metrics.FilterSpec
    Kansoku.Metrics.FunnelIntegrationSpec
    Kansoku.Metrics.FunnelReferenceSpec
    Kansoku.Metrics.HandlerSpec
    Kansoku.Metrics.LimitsSpec
    Kansoku.Metrics.RoutingSpec
    Kansoku.Metrics.SessionIntegrationSpec
    Kansoku.MigrationsSpec
    Kansoku.ObservabilitySpec
    Kansoku.OpenApiSpec
    Kansoku.PostgresTestSupport
    Kansoku.ProblemSpec
    Kansoku.Query.ValidateSpec
    Kansoku.QueryBenchmark
    Kansoku.QueryIntegrationSpec
    Kansoku.QueryPoolSpec
    Kansoku.QuerySpec
    Kansoku.ReadinessSpec
    Kansoku.RequestLogSpec
    Kansoku.Writer.BatchSpec
    Kansoku.Writer.LifecycleSpec
    Kansoku.Writer.OutageSpec
    Kansoku.Writer.RecoverySpec

  build-depends:
    ClickHaskell,
    aeson,
    async,
    base >=4.21 && <5,
    bytestring,
    containers,
    directory,
    effectful,
    generic-lens,
    hasql,
    hasql-pool,
    hs-opentelemetry-api,
    hs-opentelemetry-exporter-in-memory,
    hs-opentelemetry-instrumentation-wai,
    hs-opentelemetry-propagator-w3c,
    hs-opentelemetry-sdk,
    hspec,
    http-api-data,
    http-client,
    http-types,
    iproute,
    kansoku-api,
    kansoku-core,
    network,
    openapi-hs,
    pg-migrate,
    pg-migrate-test-support,
    pgmq-core,
    pgmq-effectful,
    pgmq-hasql,
    process,
    prometheus-client,
    servant,
    servant-client,
    servant-client-core,
    servant-health,
    servant-server,
    shibuya-core,
    shibuya-pgmq-adapter,
    streamly-core,
    text,
    time,
    unordered-containers,
    uuid,
    wai,
    warp,

test-suite kansoku-probe-test
  import: common
  type: exitcode-stdio-1.0
  ghc-options: -threaded
  hs-source-dirs: probe-test
  main-is: Main.hs
  build-depends:
    base,
    kansoku-core,
    servant-health,
    servant-health:testkit,
    tasty,
