cabal-version: 3.0
name:          kansoku-core
version:       0.1.0.0
synopsis:
  Core Kansoku runtime, storage, ingestion, and metrics logic.

description:
  Kansoku core contains the effectful runtime, configuration, logging,
  persistence adapters, ingestion queueing, metric query implementation, OpenAPI
  generation, and HTTP application assembly shared by the server executable.

license:       BSD-3-Clause
author:        Nadeem Bitar
maintainer:    nadeem@gmail.com
category:      Web
build-type:    Simple

common common
  ghc-options:        -Wall -Wcompat -Wredundant-constraints
  default-language:   GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

library
  import:          common
  hs-source-dirs:  src
  exposed-modules:
    Kansoku
    Kansoku.ClickHouse
    Kansoku.ClickHouse.EventRow
    Kansoku.Config
    Kansoku.Ingest.Handler
    Kansoku.Ingest.Producer
    Kansoku.Ingest.Queue
    Kansoku.Logging
    Kansoku.Metrics.Definition
    Kansoku.Metrics.Handler
    Kansoku.Metrics.Registry
    Kansoku.OpenApi
    Kansoku.Postgres
    Kansoku.Query
    Kansoku.Runtime
    Kansoku.Server
    Kansoku.Telemetry
    Kansoku.Writer.Batch
    Kansoku.Writer.Run

  build-depends:
    , aeson
    , async
    , base                  >=4.21 && <5
    , bytestring
    , ClickHaskell
    , containers
    , effectful
    , effectful-core
    , generic-lens          >=2.2  && <2.4
    , hasql
    , hasql-pool
    , hs-opentelemetry-api
    , http-types
    , kansoku-api
    , openapi-hs
    , pgmq-core
    , pgmq-effectful
    , pgmq-hasql
    , pgmq-migration
    , servant
    , servant-openapi-hs
    , servant-server
    , shibuya-core
    , shibuya-pgmq-adapter
    , text
    , time
    , unordered-containers
    , wai
    , warp

test-suite kansoku-core-test
  import:         common
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  other-modules:
    Kansoku.ClickHouseSpec
    Kansoku.ConfigSpec
    Kansoku.EventSpec
    Kansoku.Ingest.QueueSpec
    Kansoku.OpenApiSpec
    Kansoku.QuerySpec
    Kansoku.Writer.BatchSpec

  build-depends:
    , aeson
    , base                  >=4.21 && <5
    , bytestring
    , ClickHaskell
    , effectful
    , generic-lens
    , hspec
    , kansoku-api
    , kansoku-core
    , openapi-hs
    , pgmq-core
    , shibuya-core
    , text
    , time
    , unordered-containers
