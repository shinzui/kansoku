            "$ref": "#/components/schemas/SessionId"
          },
          "source": {
            "$ref": "#/components/schemas/EventSource"
          },
          "sourceEventId": {
            "$ref": "#/components/schemas/SourceEventId"
          },
          "sourceGlobalPosition": {
            "format": "int64",
            "maximum": 9223372036854775807,
            "minimum": -9223372036854775808,
            "type": "integer"
          },
          "sourceService": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "userId": {
            "$ref": "#/components/schemas/UserId"
          },
          "utmCampaign": {
            "type": "string"
          },
          "utmContent": {
            "type": "string"
          },
          "utmMedium": {
            "type": "string"
          },
          "utmSource": {
            "type": "string"
          },
          "utmTerm": {
            "type": "string"
          }
        },
        "required": [
          "eventId",
          "eventName",
          "source",
          "occurredAt",
          "receivedAt",
          "properties",
          "context"
        ],
        "type": "object"
      },
      "AnonymousId": {
        "type": "string"
      },
      "BatchAck": {
        "properties": {
          "accepted": {
            "maximum": 9223372036854775807,
            "minimum": -9223372036854775808,
            "type": "integer"
          }
        },
        "required": [
          "accepted"
        ],
        "type": "object"
      },
      "CausationId": {
        "type": "string"
      },
      "CorrelationId": {
        "type": "string"
      },
