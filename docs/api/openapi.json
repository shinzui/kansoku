        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "type": "object"
      },
      "EventId": {
        "type": "string"
      },
      "EventName": {
        "type": "string"
      },
      "EventSource": {
        "enum": [
          "web",
          "app",
          "service",
          "worker",
          "email",
          "agent"
        ],
        "type": "string"
      },
      "IngestAck": {
        "properties": {
          "accepted": {
            "maximum": 9223372036854775807,
            "minimum": -9223372036854775808,
            "type": "integer"
          },
          "eventId": {
            "type": "string"
          }
        },
        "required": [
          "accepted",
          "eventId"
        ],
        "type": "object"
      },
      "MetricPoint": {
        "properties": {
          "bucket": {
            "type": "string"
          },
          "group": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "value": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "group",
          "value"
        ],
        "type": "object"
      },
      "MetricResult": {
        "properties": {
          "metric": {
            "type": "string"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/MetricPoint"
            },
            "type": "array"
          }
        },
        "required": [
          "metric",
          "points"
        ],
        "type": "object"
      },
      "Object": {
        "additionalProperties": true,
        "description": "Arbitrary JSON object.",
        "type": "object"
      },
      "OrganizationId": {
        "type": "string"
      },
      "SessionId": {
        "type": "string"
      },
      "SourceEventId": {
        "type": "string"
      },
      "UTCTime": {
        "example": "2016-07-22T00:00:00Z",
        "format": "yyyy-mm-ddThh:MM:ssZ",
        "type": "string"
      },
      "UserId": {
        "type": "string"
      }
    }
  },
