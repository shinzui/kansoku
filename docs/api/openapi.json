            "$ref": "#/components/schemas/CorrelationId"
          },
          "eventId": {
            "$ref": "#/components/schemas/EventId"
          },
          "eventName": {
            "$ref": "#/components/schemas/EventName"
          },
          "occurredAt": {
            "$ref": "#/components/schemas/UTCTime"
          },
          "organizationId": {
            "$ref": "#/components/schemas/OrganizationId"
          },
          "properties": {
            "$ref": "#/components/schemas/Object"
          },
